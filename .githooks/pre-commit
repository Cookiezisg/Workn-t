#!/bin/sh
# Runs what a release must pass, before every commit.
# Enable once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
out=$(claude plugin validate . 2>&1) || { printf '%s\n' "$out"; exit 1; }
# Type errors are reported as warnings: treat them as failures here.
if printf '%s' "$out" | grep -q 'error TS'; then printf '%s\n' "$out"; exit 1; fi
out=$(claude plugin test . 2>&1) || { printf '%s\n' "$out" | tail -40; exit 1; }
printf '%s\n' "$out" | tail -3
